From 02420d600550b42aa17a9d75d0b56821ae9b550a Mon Sep 17 00:00:00 2001
From: Robert Osfield <robert.osfield@gmail.com>
Date: Sun, 16 Nov 2025 12:45:40 +0000
Subject: [PATCH] Use current vsg mipmap property

Backport the mipLevels part of upstream 02420d6 for vsg 1.1.15.

---
 src/osg2vsg/ImageUtils.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/osg2vsg/ImageUtils.cpp b/src/osg2vsg/ImageUtils.cpp
index 2e9e4e3..19c5dd2 100644
--- a/src/osg2vsg/ImageUtils.cpp
+++ b/src/osg2vsg/ImageUtils.cpp
@@ -285,7 +285,7 @@ namespace osg2vsg
         void* data = vsg::allocate(size, vsg::ALLOCATOR_AFFINITY_DATA);
         memcpy(data, image->data(), size);
 
-        layout.maxNumMipmaps = image->getNumMipmapLevels();
+        layout.mipLevels = image->getNumMipmapLevels();
 
         uint32_t width = image->s() / layout.blockWidth;
         uint32_t height = image->t() / layout.blockHeight;
@@ -469,7 +469,7 @@ namespace osg2vsg
         }
 
         vsg::Data::Properties& layout = vsg_data->properties;
-        layout.maxNumMipmaps = image->getNumMipmapLevels();
+        layout.mipLevels = image->getNumMipmapLevels();
         layout.origin = (image->getOrigin() == osg::Image::BOTTOM_LEFT) ? vsg::BOTTOM_LEFT : vsg::TOP_LEFT;
 
         return vsg_data;
-- 
2.53.0
